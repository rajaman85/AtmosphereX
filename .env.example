# AtmosphereX Environment Variables
# Copy this file to .env and fill in actual values

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database
DATABASE_URL=postgresql://atmospherex:atmospherex_pass@localhost:5432/atmospherex_db
POSTGRES_USER=atmospherex
POSTGRES_PASSWORD=atmospherex_pass
POSTGRES_DB=atmospherex_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Weather Provider (Open-Meteo - No API key needed)
# Open-Meteo is free and doesn't require an API key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEO_URL=https://geocoding-api.open-meteo.com/v1
OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=atmospherex123
